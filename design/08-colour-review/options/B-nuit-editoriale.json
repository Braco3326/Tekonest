 "extra_css": "\n.status::before{width:11px;height:11px;box-sizing:border-box;border:2px solid var(--color-ink);background:transparent}\n.status--now::before{background:var(--color-ink)}\n.status--dev::before{background:linear-gradient(90deg,var(--color-ink) 50%,transparent 50%)}\n.status--prep::before{}\n.status--later::before{border:2px dotted var(--color-ink)}\n\n.btn-primary:hover{background:#2C2550}\n.site-footer p{color:#B9B2CC} .site-footer .fine{border-top-color:#3A3358}\n/* Soirées = the night: full-bleed Nuit de salle hero, sodium clair as the light source */\n.branch-hero[style*=\"--cable-soirees\"]{background:#1B1736;color:#F4F0EA;padding-block:72px;--color-ink:#F4F0EA;--color-ink-2:#B9B2CC;--color-ink-3:#B9B2CC;\n  --color-signal:#FF8A4C;--cable:#FF8A4C;--color-line-strong:#7E7699}\n.branch-hero[style*=\"--cable-soirees\"] .btn-primary{background:#F4F0EA;color:#1B1736}\n.branch-hero[style*=\"--cable-soirees\"] .btn:disabled{background:#2C2550;color:#B9B2CC;border-color:#7E7699}\n",
