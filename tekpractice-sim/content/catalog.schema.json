{
  "$ref": "#/definitions/Catalog",
  "definitions": {
    "Catalog": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number"
        },
        "meta": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "connectorTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "gender": {
                "type": "string",
                "enum": [
                  "male",
                  "female",
                  "universal"
                ]
              },
              "matesWith": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "label",
              "gender",
              "matesWith"
            ],
            "additionalProperties": false
          }
        },
        "signalTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "enum": [
                  "analog",
                  "digital",
                  "control",
                  "power"
                ]
              }
            },
            "required": [
              "id",
              "label",
              "class"
            ],
            "additionalProperties": false
          }
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "levels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "realWorld": {
                "type": "object",
                "properties": {
                  "brand": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "category": {
                    "type": "string",
                    "minLength": 1
                  },
                  "typicalUse": {
                    "type": "string",
                    "minLength": 1
                  },
                  "notes": {
                    "type": "string"
                  }
                },
                "required": [
                  "brand",
                  "model",
                  "category",
                  "typicalUse",
                  "notes"
                ],
                "additionalProperties": false
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "portId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "dir": {
                      "type": "string",
                      "enum": [
                        "in",
                        "out",
                        "bidir"
                      ]
                    },
                    "connector": {
                      "type": "string",
                      "minLength": 1
                    },
                    "signal": {
                      "type": "string",
                      "minLength": 1
                    },
                    "flags": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "providesPhantom",
                          "requiresPhantom",
                          "isClockMaster",
                          "isClockSlave",
                          "isMicInput",
                          "isMonitorOut",
                          "isOnAirTally",
                          "isDantePrimary",
                          "isMainsSource"
                        ],
                        "description": "A behaviour flag on a port that logic/* reads. isMainsSource (C7, Task 32): an output that really supplies mains; a mains-power output without it (a Bêta proposal) powers nothing."
                      }
                    }
                  },
                  "required": [
                    "portId",
                    "dir",
                    "connector",
                    "signal"
                  ],
                  "additionalProperties": false
                }
              },
              "controls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "toggle"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "default": {
                      "type": "boolean"
                    },
                    "enables": {
                      "type": "object",
                      "properties": {
                        "flag": {
                          "type": "string",
                          "enum": [
                            "providesPhantom",
                            "requiresPhantom",
                            "isClockMaster",
                            "isClockSlave",
                            "isMicInput",
                            "isMonitorOut",
                            "isOnAirTally",
                            "isDantePrimary",
                            "isMainsSource"
                          ],
                          "description": "A behaviour flag on a port that logic/* reads. isMainsSource (C7, Task 32): an output that really supplies mains; a mains-power output without it (a Bêta proposal) powers nothing."
                        },
                        "ports": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1
                        }
                      },
                      "required": [
                        "flag",
                        "ports"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "id",
                    "type",
                    "label",
                    "default"
                  ],
                  "additionalProperties": false
                }
              },
              "routing": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Where the signal enters: an input (or bidir) port id of this device, or \"control:<controlId>\" for a source inside the device (e.g. \"control:playback-usb\")."
                    },
                    "to": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "description": "Where it leaves: output (or bidir) port ids of this device, or the pseudo-target \"transducer\" (the device is a loudspeaker and this route feeds its drivers)."
                    },
                    "channels": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "L",
                          "R"
                        ]
                      },
                      "description": "Stereo channel carried to each target, parallel to `to` (same length, P7): [\"L\",\"R\"] sends left to the first output and right to the second."
                    },
                    "passive": {
                      "type": "boolean",
                      "description": "True for a parallel link that works with the device unpowered (P7): a loop-thru / link out the knowledge base documents. Absent = the route needs the device powered."
                    },
                    "when": {
                      "type": "object",
                      "properties": {
                        "control": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Id of a control of this device."
                        },
                        "equals": {
                          "type": [
                            "boolean",
                            "string"
                          ],
                          "description": "Value that control must have for the route to be live: a boolean for a toggle, one of the options for an enum."
                        }
                      },
                      "required": [
                        "control",
                        "equals"
                      ],
                      "additionalProperties": false,
                      "description": "The route is live only while this control has this value (e.g. playback-usb on). Absent = always live."
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false
                },
                "description": "Signal routes of the device (C8): consumed by the signal path only. Verified data: a Bêta proposal never carries routing (parseProposals drops it)."
              }
            },
            "required": [
              "id",
              "label",
              "levels",
              "realWorld",
              "ports"
            ],
            "additionalProperties": false
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^R[1-8]$"
              },
              "slug": {
                "type": "string",
                "minLength": 1
              },
              "module": {
                "type": "string",
                "enum": [
                  "engine",
                  "logic/phantom",
                  "logic/gpio",
                  "logic/mixMinus",
                  "logic/clock"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "check": {
                "type": "string",
                "minLength": 1
              },
              "teach": {
                "type": "string",
                "minLength": 1
              },
              "title_fr": {
                "type": "string",
                "minLength": 1,
                "description": "French title of the rule, shown at the refused port, in the error list and in the Connecter à… dialog (Mode Création)."
              },
              "teach_fr": {
                "type": "string",
                "minLength": 1,
                "description": "French teaching text of the rule, shown as the detail line in the error list and under the reason in the Connecter à… dialog (Mode Création)."
              }
            },
            "required": [
              "id",
              "slug",
              "module",
              "severity",
              "title",
              "check",
              "teach",
              "title_fr",
              "teach_fr"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "meta",
        "connectorTypes",
        "signalTypes",
        "devices",
        "rules"
      ],
      "additionalProperties": true
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
