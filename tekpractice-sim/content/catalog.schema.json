{
  "$ref": "#/definitions/Catalog",
  "definitions": {
    "Catalog": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number"
        },
        "meta": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "connectorTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "gender": {
                "type": "string",
                "enum": [
                  "male",
                  "female",
                  "universal"
                ]
              },
              "matesWith": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "label",
              "gender",
              "matesWith"
            ],
            "additionalProperties": false
          }
        },
        "signalTypes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "enum": [
                  "analog",
                  "digital",
                  "control",
                  "power"
                ]
              }
            },
            "required": [
              "id",
              "label",
              "class"
            ],
            "additionalProperties": false
          }
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "levels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "realWorld": {
                "type": "object",
                "properties": {
                  "brand": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "category": {
                    "type": "string",
                    "minLength": 1
                  },
                  "typicalUse": {
                    "type": "string",
                    "minLength": 1
                  },
                  "notes": {
                    "type": "string"
                  }
                },
                "required": [
                  "brand",
                  "model",
                  "category",
                  "typicalUse",
                  "notes"
                ],
                "additionalProperties": false
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "portId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "dir": {
                      "type": "string",
                      "enum": [
                        "in",
                        "out",
                        "bidir"
                      ]
                    },
                    "connector": {
                      "type": "string",
                      "minLength": 1
                    },
                    "signal": {
                      "type": "string",
                      "minLength": 1
                    },
                    "flags": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "providesPhantom",
                          "requiresPhantom",
                          "isClockMaster",
                          "isClockSlave",
                          "isMicInput",
                          "isMonitorOut",
                          "isOnAirTally",
                          "isDantePrimary",
                          "isMainsSource",
                          "isRibbon",
                          "isUnbalanced",
                          "isInsert",
                          "isSendReturn",
                          "isMixMinus",
                          "isTally"
                        ],
                        "description": "A behaviour flag on a port that logic/* reads. isMainsSource (C7, Task 32): an output that really supplies mains; a mains-power output without it (a Bêta proposal) powers nothing. Wave 0 (build all equipment) additions, data only until a rule reads them: isRibbon (a ribbon microphone output: must not receive phantom), isUnbalanced (a TS / RCA style unbalanced connection), isInsert (a TRS insert send/return point), isSendReturn (an effects send or return), isMixMinus (a mix-minus / N-1 bus output), isTally (a tally or on-air lamp port on a gpio-tally signal)."
                      }
                    }
                  },
                  "required": [
                    "portId",
                    "dir",
                    "connector",
                    "signal"
                  ],
                  "additionalProperties": false
                }
              },
              "controls": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "type": {
                          "type": "string",
                          "const": "toggle"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "default": {
                          "type": "boolean"
                        },
                        "enables": {
                          "type": "object",
                          "properties": {
                            "flag": {
                              "type": "string",
                              "enum": [
                                "providesPhantom",
                                "requiresPhantom",
                                "isClockMaster",
                                "isClockSlave",
                                "isMicInput",
                                "isMonitorOut",
                                "isOnAirTally",
                                "isDantePrimary",
                                "isMainsSource",
                                "isRibbon",
                                "isUnbalanced",
                                "isInsert",
                                "isSendReturn",
                                "isMixMinus",
                                "isTally"
                              ],
                              "description": "A behaviour flag on a port that logic/* reads. isMainsSource (C7, Task 32): an output that really supplies mains; a mains-power output without it (a Bêta proposal) powers nothing. Wave 0 (build all equipment) additions, data only until a rule reads them: isRibbon (a ribbon microphone output: must not receive phantom), isUnbalanced (a TS / RCA style unbalanced connection), isInsert (a TRS insert send/return point), isSendReturn (an effects send or return), isMixMinus (a mix-minus / N-1 bus output), isTally (a tally or on-air lamp port on a gpio-tally signal)."
                            },
                            "ports": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              },
                              "minItems": 1
                            }
                          },
                          "required": [
                            "flag",
                            "ports"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "id",
                        "type",
                        "label",
                        "default"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "type": {
                          "type": "string",
                          "const": "enum"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "options": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 2
                        },
                        "defaultOption": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id",
                        "type",
                        "label",
                        "options",
                        "defaultOption"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "acoustic": {
                "type": "object",
                "properties": {
                  "coverage_h_deg": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "description": "The value itself, copied from its source (never estimated)."
                      },
                      "source": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "datasheet",
                              "kb",
                              "nominal"
                            ],
                            "description": "datasheet = the manufacturer document; kb = the TekPractice knowledge base (knowledge-base/equipment); nominal = a stated default for a loudspeaker the KB gives no coverage for, allowed only as the 90 x 60 coverage pair."
                          },
                          "ref": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Where to check it: the knowledge-base note path + entry id + field (and the quoted text when the value is copied from it), or the manufacturer document. For kind nominal: « valeur nominale » and why."
                          },
                          "retrieved": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                            "description": "Date the source was read (YYYY-MM-DD): the date of the KB note for kind kb. For kind nominal there is no source document: the date is when the value was entered / checked against the KB (the absence of data), not a retrieval."
                          }
                        },
                        "required": [
                          "kind",
                          "ref",
                          "retrieved"
                        ],
                        "additionalProperties": false,
                        "description": "Provenance of the value (decision C12): every acoustic value has one."
                      }
                    },
                    "required": [
                      "value",
                      "source"
                    ],
                    "additionalProperties": false,
                    "description": "Horizontal coverage angle of the loudspeaker, in degrees."
                  },
                  "coverage_v_deg": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "description": "The value itself, copied from its source (never estimated)."
                      },
                      "source": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "datasheet",
                              "kb",
                              "nominal"
                            ],
                            "description": "datasheet = the manufacturer document; kb = the TekPractice knowledge base (knowledge-base/equipment); nominal = a stated default for a loudspeaker the KB gives no coverage for, allowed only as the 90 x 60 coverage pair."
                          },
                          "ref": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Where to check it: the knowledge-base note path + entry id + field (and the quoted text when the value is copied from it), or the manufacturer document. For kind nominal: « valeur nominale » and why."
                          },
                          "retrieved": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                            "description": "Date the source was read (YYYY-MM-DD): the date of the KB note for kind kb. For kind nominal there is no source document: the date is when the value was entered / checked against the KB (the absence of data), not a retrieval."
                          }
                        },
                        "required": [
                          "kind",
                          "ref",
                          "retrieved"
                        ],
                        "additionalProperties": false,
                        "description": "Provenance of the value (decision C12): every acoustic value has one."
                      }
                    },
                    "required": [
                      "value",
                      "source"
                    ],
                    "additionalProperties": false,
                    "description": "Vertical coverage angle of the loudspeaker, in degrees."
                  },
                  "max_spl_db": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "number",
                        "description": "The value itself, copied from its source (never estimated)."
                      },
                      "source": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "datasheet",
                              "kb",
                              "nominal"
                            ],
                            "description": "datasheet = the manufacturer document; kb = the TekPractice knowledge base (knowledge-base/equipment); nominal = a stated default for a loudspeaker the KB gives no coverage for, allowed only as the 90 x 60 coverage pair."
                          },
                          "ref": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Where to check it: the knowledge-base note path + entry id + field (and the quoted text when the value is copied from it), or the manufacturer document. For kind nominal: « valeur nominale » and why."
                          },
                          "retrieved": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                            "description": "Date the source was read (YYYY-MM-DD): the date of the KB note for kind kb. For kind nominal there is no source document: the date is when the value was entered / checked against the KB (the absence of data), not a retrieval."
                          }
                        },
                        "required": [
                          "kind",
                          "ref",
                          "retrieved"
                        ],
                        "additionalProperties": false,
                        "description": "Provenance of the value (decision C12): every acoustic value has one."
                      }
                    },
                    "required": [
                      "value",
                      "source"
                    ],
                    "additionalProperties": false,
                    "description": "Maximum SPL in dB at 1 m, as the source states it (peak or continuous: say which in source.ref). Omitted when the source gives no value."
                  },
                  "sensitivity_db": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "number",
                        "description": "The value itself, copied from its source (never estimated)."
                      },
                      "source": {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "datasheet",
                              "kb",
                              "nominal"
                            ],
                            "description": "datasheet = the manufacturer document; kb = the TekPractice knowledge base (knowledge-base/equipment); nominal = a stated default for a loudspeaker the KB gives no coverage for, allowed only as the 90 x 60 coverage pair."
                          },
                          "ref": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Where to check it: the knowledge-base note path + entry id + field (and the quoted text when the value is copied from it), or the manufacturer document. For kind nominal: « valeur nominale » and why."
                          },
                          "retrieved": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                            "description": "Date the source was read (YYYY-MM-DD): the date of the KB note for kind kb. For kind nominal there is no source document: the date is when the value was entered / checked against the KB (the absence of data), not a retrieval."
                          }
                        },
                        "required": [
                          "kind",
                          "ref",
                          "retrieved"
                        ],
                        "additionalProperties": false,
                        "description": "Provenance of the value (decision C12): every acoustic value has one."
                      }
                    },
                    "required": [
                      "value",
                      "source"
                    ],
                    "additionalProperties": false,
                    "description": "Sensitivity in dB SPL (1 W, 1 m), as the source states it. Omitted when the source gives no value."
                  }
                },
                "required": [
                  "coverage_h_deg",
                  "coverage_v_deg"
                ],
                "additionalProperties": false,
                "description": "Sourced acoustic fields of a loudspeaker (C12): coverage, max SPL, sensitivity, each with its provenance. Verified data: a Bêta proposal never carries acoustic (parseProposals drops it)."
              },
              "modelFront": {
                "type": "object",
                "properties": {
                  "axis": {
                    "type": "string",
                    "enum": [
                      "+x",
                      "-x",
                      "+z",
                      "-z"
                    ],
                    "description": "Direction the front (the grille / driver face of a loudspeaker) faces, in the glTF model space of public/assets/<id>.glb."
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1,
                    "description": "How it was measured: what is on that face (grille, driver), what is on the opposite one, and where the file was read."
                  }
                },
                "required": [
                  "axis",
                  "evidence"
                ],
                "additionalProperties": false,
                "description": "Where the front of the shipped .glb faces (glTF model space), measured on the file: Mode Création turns the model so that it faces +z at yaw 0, where the acoustics aim. Absent = not established. Verified data: a Bêta proposal never carries it."
              },
              "modelBody": {
                "type": "object",
                "properties": {
                  "baseFraction": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "exclusiveMaximum": 1,
                    "description": "Share (0 to 1) of the total height of the model, from its lowest point, that is stand under the cabinet."
                  },
                  "cabinetHeightM": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Real height in metres of the cabinet alone (the model without the stand), from the datasheet: the target of the height normalisation in Mode Création."
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1,
                    "description": "How it was measured on public/assets/<id>.glb: where the neck ends and the cabinet starts, and where cabinetHeightM comes from."
                  }
                },
                "required": [
                  "baseFraction",
                  "cabinetHeightM",
                  "evidence"
                ],
                "additionalProperties": false,
                "description": "A floor stand included in the shipped .glb (share of the model height): Mode Création normalises the height of the cabinet, not of the whole model. Absent = the model is the device alone. Verified data: a Bêta proposal never carries it."
              },
              "routing": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Where the signal enters: an input (or bidir) port id of this device, or \"control:<controlId>\" for a source inside the device (e.g. \"control:playback-usb\")."
                    },
                    "to": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1,
                      "description": "Where it leaves: output (or bidir) port ids of this device, or the pseudo-target \"transducer\" (the device is a loudspeaker and this route feeds its drivers)."
                    },
                    "channels": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "L",
                          "R"
                        ]
                      },
                      "description": "Stereo channel carried to each target, parallel to `to` (same length, P7): [\"L\",\"R\"] sends left to the first output and right to the second."
                    },
                    "passive": {
                      "type": "boolean",
                      "description": "Hypothèse pédagogique du plan (P7), non sourcée : la liaison fonctionne même hors tension. The knowledge base only names the output (K12.2 \"loop-thru outputs\"; DBR12 \"CH1 parallel through or CH1+CH2 mix\"): that it is a parallel link and works unpowered is the plan's simplification, not a sourced fact. Absent = the route needs the device powered."
                    },
                    "when": {
                      "type": "object",
                      "properties": {
                        "control": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Id of a control of this device."
                        },
                        "equals": {
                          "type": [
                            "boolean",
                            "string"
                          ],
                          "description": "Value that control must have for the route to be live: a boolean for a toggle, one of the options for an enum."
                        }
                      },
                      "required": [
                        "control",
                        "equals"
                      ],
                      "additionalProperties": false,
                      "description": "The route is live only while this control has this value (e.g. playback-usb on). Absent = always live."
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false
                },
                "description": "Signal routes of the device (C8): consumed by the signal path only. Verified data: a Bêta proposal never carries routing (parseProposals drops it)."
              },
              "loadOhms": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Wave 0: the load in ohms the device presents or is rated at: the nominal load of a passive loudspeaker input, or the load the stated power of an amplifier is quoted into. Absent = not stated."
              },
              "minLoadOhms": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Wave 0: the lowest load in ohms an amplifier output is rated to drive (per channel). Must not exceed loadOhms when both are given. Absent = not stated."
              },
              "impedanceOhms": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "Wave 0: the nominal impedance in ohms of a loudspeaker, or of an input / output the datasheet states (a line input, an instrument Hi-Z input). Absent = not stated."
              },
              "sizeMm": {
                "type": "object",
                "properties": {
                  "w": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "d": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "h": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": false,
                "description": "Wave 0: the real size in millimetres from the equipment plan, any subset of w (width), d (depth), h (height). Read only for the placeholder box of a device that has no model yet (a Bêta proposal): a device with a model takes its size from the model. Absent = category footprint."
              }
            },
            "required": [
              "id",
              "label",
              "levels",
              "realWorld",
              "ports"
            ],
            "additionalProperties": false
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^R[1-8]$"
              },
              "slug": {
                "type": "string",
                "minLength": 1
              },
              "module": {
                "type": "string",
                "enum": [
                  "engine",
                  "logic/phantom",
                  "logic/gpio",
                  "logic/mixMinus",
                  "logic/clock"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "check": {
                "type": "string",
                "minLength": 1
              },
              "teach": {
                "type": "string",
                "minLength": 1
              },
              "title_fr": {
                "type": "string",
                "minLength": 1,
                "description": "French title of the rule, shown at the refused port, in the error list and in the Connecter à… dialog (Mode Création)."
              },
              "teach_fr": {
                "type": "string",
                "minLength": 1,
                "description": "French teaching text of the rule, shown as the detail line in the error list and under the reason in the Connecter à… dialog (Mode Création)."
              }
            },
            "required": [
              "id",
              "slug",
              "module",
              "severity",
              "title",
              "check",
              "teach",
              "title_fr",
              "teach_fr"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "meta",
        "connectorTypes",
        "signalTypes",
        "devices",
        "rules"
      ],
      "additionalProperties": true
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
