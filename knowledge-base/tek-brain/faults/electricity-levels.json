          "cause": "Boucle de masse entre deux appareils alimentés sur des prises différentes et reliés par un blindage",
          "likelihood": "high"
        },
        {
          "cause": "Liaison asymétrique ou mixte sym/asym (ordinateur, lecteur, clavier)",
          "likelihood": "high"
        },
        {
          "cause": "Appareil avec problème de broche 1 (blindage relié à la masse audio)",
          "likelihood": "medium"
        },
        {
          "cause": "Induction par un transformateur ou un câble secteur proche d'un circuit à fort gain",
          "likelihood": "low"
        }
      ],
      "checks": [
