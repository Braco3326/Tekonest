    {
      "id": "mains-earth-lifted",
      "name_fr": "Terre secteur supprimée sur un appareil de classe I",
      "name_en": "Mains protective earth lifted",
      "domain": "safety",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "error",
      "scope": "connection",
      "condition": {
        "all": [
          {
            "path": "src.port.signal",
            "op": "eq",
            "value": "mains-power"
          },
          {
            "any": [
              {
                "path": "src.port.flags",
                "op": "includes",
                "value": "earthLifted"
              },
              {
                "path": "dst.port.flags",
                "op": "includes",
                "value": "earthLifted"
              }
            ]
          },
          {
            "path": "dst.device.protection_class",
            "op": "ne",
            "value": "II"
          }
        ]
      },
      "explanation": "La protection contre les contacts indirects d'un appareil de classe I repose sur la mise à la terre de ses masses avec coupure automatique. Une liaison secteur sans conducteur de terre (adaptateur sans terre, broche de terre coupée, prise non reliée) supprime cette protection : un défaut d'isolement met le châssis sous tension sans coupure. Ce n'est jamais un remède au ronflement.",
      "fix": "Rétablir une liaison secteur avec terre ; traiter le ronflement côté audio (liaison symétrique, DI avec ground lift audio, même distribution électrique).",
      "evaluable_now": false,
      "needs_catalog_fields": [
        "port.flags:earthLifted",
        "device.protection_class"
      ],
      "concept_ids": [
        "electrical-safety-earthing",
        "electric-shock-effects",
        "ground-loop"
      ],
      "sources": [
        {
          "url": "https://www.inrs.fr/risques/electriques/prevention-risque-electrique.html",
          "publisher": "INRS",
          "accessed": "2026-10-22",
