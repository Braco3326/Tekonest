      "id": "100v-line-overload",
      "name_fr": "Ligne 100 V surchargée",
      "name_en": "100 V line overload",
      "domain": "installation-conference",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "error",
      "scope": "device",
      "condition": {
        "all": [
          {
            "path": "device.controls.output_mode",
            "op": "eq",
            "value": "hi-z-100v"
          },
          {
            "path": "device.computed.hiz_load_ratio",
            "op": "gt",
            "value": 1.0
          }
        ]
      },
      "explanation": "La somme des prises des haut-parleurs d'une ligne dépasse la puissance 100 V du canal d'ampli. hiz_load_ratio = somme des prises (W) / puissance nominale 100 V du canal (W). Les fabricants demandent en plus une marge (80 % chez Origin Acoustics, 90 % chez AVSL) ; une version « warning » au-dessus de 0,8 pourrait être ajoutée.",
      "fix": "Baisser des prises, répartir les haut-parleurs sur un autre canal ou ajouter un ampli esclave.",
      "evaluable_now": false,
      "needs_catalog_fields": [
        "device.specs.rated_power_100v_w",
        "port.tap_power_w",
        "device.controls.output_mode",
        "device.computed.hiz_load_ratio",
        "port.signal:speaker-level-100v-line"
      ],
