      "name_fr": "Sauvegarde 3-2-1 incomplète",
      "name_en": "Incomplete 3-2-1 backup",
      "domain": "studio-recording",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "warning",
      "scope": "session",
      "condition": {
        "any": [
          {
            "path": "session.backup.copies_total",
            "op": "lt",
            "value": 3
          },
          {
            "path": "session.backup.media_types",
            "op": "lt",
            "value": 2
          },
          {
            "path": "session.backup.offsite_copies",
            "op": "lt",
            "value": 1
          }
        ]
      },
      "explanation": "La règle 3-2-1 demande 3 copies (1 principale + 2 sauvegardes), sur 2 types de supports, dont 1 hors site. Moins que cela expose la session à une panne, un vol ou un sinistre.",
      "fix": "Ajouter les copies manquantes sur un autre type de support et en dehors du studio, puis les vérifier.",
      "evaluable_now": false,
      "needs_catalog_fields": [
