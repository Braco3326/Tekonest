    {
      "id": "cue-send-post-fader",
      "name_fr": "Envoi casque en post-fader",
      "name_en": "Cue send set post-fader",
      "domain": "studio-recording",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "warning",
      "scope": "connection",
      "condition": {
        "all": [
          {
            "path": "src.port.flags",
            "op": "includes",
            "value": "isCueSend"
          },
          {
            "path": "src.device.controls.send_position",
            "op": "eq",
            "value": "post-fader"
          }
        ]
      },
      "explanation": "Un envoi post-fader suit le fader de la voie : chaque mouvement du mix régie change le retour du musicien. Les retours se font en pré-fader pour rester indépendants du mix principal.",
      "fix": "Passer l'envoi casque en pré-fader (ou utiliser le mixeur DSP de l'interface).",
      "evaluable_now": false,
      "needs_catalog_fields": [
        "port.flags:isCueSend",
