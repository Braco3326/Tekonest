      "id": "record-peak-clipping",
      "name_fr": "Prise écrêtée à 0 dBFS",
      "name_en": "Recorded take clipping at 0 dBFS",
      "domain": "studio-recording",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "error",
      "scope": "session",
      "condition": {
        "path": "session.take_peak_dbfs",
        "op": "gte",
        "value": 0
      },
      "explanation": "En numérique, rien n'existe au-dessus de la pleine échelle : un signal qui atteint 0 dBFS est écrêté et la prise est irrécupérable. L'EBU R 68 place le niveau d'alignement 18 dB sous la pleine échelle pour garder de la marge.",
      "fix": "Baisser le gain du préampli (ou insérer un pad) et refaire la prise.",
      "evaluable_now": false,
      "needs_catalog_fields": [
        "session.take_peak_dbfs"
