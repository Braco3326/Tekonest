      "id": "session-sample-rate-mismatch",
      "name_fr": "Fichier importé à une autre fréquence que la session",
      "name_en": "Session sample-rate mismatch on import",
      "domain": "studio-recording",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "error",
      "scope": "session",
      "condition": {
        "all": [
          {
            "path": "session.import.sample_rate_matches_project",
            "op": "eq",
            "value": false
          },
          {
            "path": "session.import.src_applied",
            "op": "eq",
            "value": false
          }
        ]
      },
      "explanation": "Un fichier lu à une fréquence différente de celle où il a été enregistré change de vitesse et de hauteur ; la conversion de fréquence (SRC) évite ce changement. Exemple : un fichier 44,1 kHz lu sans conversion dans une session 48 kHz joue trop vite et trop aigu.",
      "fix": "Convertir le fichier à la fréquence de la session à l'import (ou rendre le fichier à la bonne fréquence), et vérifier la fréquence de la session avant de commencer.",
      "evaluable_now": false,
      "needs_catalog_fields": [
