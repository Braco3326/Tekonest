    {
      "id": "aux-monitor-send-post-fader",
      "name_fr": "Retour de scène alimenté en post-fader",
      "name_en": "Monitor mix fed post-fader",
      "domain": "consoles-signal-flow",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "warning",
      "scope": "device",
      "condition": {
        "all": [
          {
            "path": "device.controls.monitorBusSendPoint",
            "op": "eq",
            "value": "post"
          }
        ]
      },
      "explanation": "Un bus auxiliaire qui alimente une sortie de retour (port isMonitorOut) devrait être prélevé en pré-fader : en post-fader, chaque mouvement de fader de la façade (et, sur la plupart des consoles à VCA, chaque mouvement de VCA) change le mélange du musicien. Mackie réserve le post aux départs d'effets et le pré aux retours de scène.",
      "fix": "Passer le bus de retour en pré-fader (ou pré-mute si le retour doit rester actif quand la façade mute la tranche).",
      "evaluable_now": false,
      "needs_catalog_fields": [
