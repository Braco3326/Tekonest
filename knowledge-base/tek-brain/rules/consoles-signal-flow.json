    {
      "id": "insert-send-return-reversed",
      "name_fr": "Envoi et retour d'insert inversés",
      "name_en": "Insert send/return reversed",
      "domain": "consoles-signal-flow",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "error",
      "scope": "connection",
      "condition": {
        "any": [
          {
            "all": [
              {
                "path": "src.port.flags",
                "op": "includes",
                "value": "isInsertSend"
              },
              {
                "path": "dst.port.dir",
                "op": "eq",
                "value": "out"
              }
            ]
          },
          {
            "all": [
              {
                "path": "dst.port.flags",
                "op": "includes",
                "value": "isInsertReturn"
              },
              {
                "path": "src.port.dir",
                "op": "eq",
                "value": "in"
              }
            ]
          }
        ]
      },
      "explanation": "Cas particulier pédagogique de R3 pour les inserts : l'envoi d'insert (pointe du jack TRS chez Mackie, jack du haut d'une baie) est une sortie qui doit aller à l'entrée du processeur ; le retour (bague, jack du bas) est une entrée qui reçoit la sortie du processeur. Les inverser relie deux sorties et deux entrées : la tranche se tait ou le processeur n'est pas dans le chemin.",
      "fix": "Envoi d'insert vers l'entrée du processeur, sortie du processeur vers le retour d'insert.",
      "evaluable_now": false,
      "needs_catalog_fields": [
        "port.flags:isInsertSend",
        "port.flags:isInsertReturn",
        "signal:insert-send-return"
      ],
      "concept_ids": [
