      "id": "monitor-mix-post-fader-send",
      "name_fr": "Mix retour alimenté en post-fader",
      "name_en": "Monitor mix fed post-fader",
      "domain": "monitoring",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "warning",
      "scope": "device",
      "condition": {
        "all": [
