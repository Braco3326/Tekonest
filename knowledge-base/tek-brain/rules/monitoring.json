    {
      "id": "feedback-risk-open-mic-same-room",
      "name_fr": "Risque de larsen : micro ouvert renvoyé dans un haut-parleur de la même zone",
      "name_en": "Feedback risk: open mic routed to a loudspeaker in the same zone",
      "domain": "monitoring",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "warning",
      "scope": "graph",
      "condition": {
        "all": [
          {
            "path": "graph.count(mic isMicInput open AND routed via aux/mix to output feeding a loudspeaker AND loudspeaker.zone == mic.zone)",
            "op": "gt",
            "value": 0
          },
          {
            "path": "session.monitor_mute_or_iem",
            "op": "ne",
            "value": true
          }
        ]
      },
      "explanation": "R6 ne couvre que les sorties isMonitorOut d'une console broadcast munie d'une commande monitor-mute. Sur une scène, le cas courant est un micro dont le canal est envoyé (aux) dans un wedge ou un side-fill de la même zone : c'est le chemin de larsen le plus court et le plus probable. Le risque augmente avec le nombre de micros ouverts (−3 dB de gain avant larsen par doublement) et quand le haut-parleur est dans l'axe du micro.",
      "fix": "Vérifier le placement du wedge dans le zéro du micro, accorder le retour (ring out), couper les micros inutilisés, ou passer aux ears.",
      "evaluable_now": false,
      "needs_catalog_fields": [
        "device.zone",
        "device.controls.aux-send-<inputPort>-<outputPort>",
        "device.category:loudspeaker"
      ],
      "concept_ids": [
        "acoustic-feedback",
        "gain-before-feedback",
        "number-of-open-microphones",
        "mic-polar-pattern-wedge-placement"
      ],
      "sources": [
        {
          "url": "https://www.shure.com/damfiles/default/global/documents/publications/en/performance-production/us_pro_guidepersonalmonitor_ea.pdf-a99329954f383dc535fac48bca2396ec.pdf",
          "publisher": "Shure — G. Sigismondi, Selection and Operation of Personal Monitor Systems, 3rd ed.",
          "accessed": "2026-10-22",
