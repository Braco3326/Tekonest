    {
      "id": "monitor-mute-open-mic",
      "name_fr": "Couper les écoutes quand un micro est ouvert",
      "name_en": "Monitor mute on open mic",
      "domain": "monitoring",
      "catalog_rule": "R6",
      "status": "existing",
      "severity": "error",
      "scope": "device",
      "condition": {
        "all": [
          {
            "path": "device.controls.fader-<isMicInput port>",
            "op": "eq",
            "value": true
          },
          {
            "path": "device.ports[flags includes isMicInput].connected",
            "op": "eq",
            "value": true
          },
          {
            "path": "device.ports[flags includes isMonitorOut].connected",
            "op": "eq",
            "value": true
          },
          {
            "path": "device.controls.monitor-mute",
            "op": "ne",
            "value": true
          }
        ]
      },
      "explanation": "Mirror de R6 (logic/gpio) : ouvrir un micro dans la pièce où des sorties d'écoute (isMonitorOut) sont actives, sans couper ces écoutes, crée une boucle de larsen. Les consoles radio coupent automatiquement les haut-parleurs de la régie quand le micro de la pièce est ouvert (Axia iQ). La v1 du simulateur suppose une seule pièce.",
      "fix": "Activer la coupure des écoutes (monitor-mute) ou fermer le fader micro ; écouter au casque micro ouvert.",
      "evaluable_now": true,
      "needs_catalog_fields": [],
      "concept_ids": [
        "monitor-mute-on-open-mic",
        "acoustic-feedback"
      ],
      "sources": [
        {
          "url": "https://telosalliance-uat.s3.amazonaws.com/public/Axia%20Products/iQ/Support%20Files/Axia_iQ_QSG_C21116017_Web.pdf",
          "publisher": "Telos Alliance / Axia — Axia iQ Quick Start Guide",
          "accessed": "2026-10-22",
          "confidence": "verified-primary",
          "kind": "manufacturer",
          "covers": [
            "explanation",
            "fix"
          ]
        },
        {
          "url": "https://www.shure.com/damfiles/default/global/documents/publications/en/performance-production/us_pro_guidepersonalmonitor_ea.pdf-a99329954f383dc535fac48bca2396ec.pdf",
          "publisher": "Shure — G. Sigismondi, Selection and Operation of Personal Monitor Systems, 3rd ed.",
          "accessed": "2026-10-22",
          "confidence": "verified-primary",
          "kind": "manufacturer",
