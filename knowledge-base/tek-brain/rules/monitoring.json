    {
      "id": "iem-without-limiter",
      "name_fr": "Récepteur d'ears sans limiteur actif",
      "name_en": "IEM receiver without active limiter",
      "domain": "monitoring",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "warning",
      "scope": "device",
      "condition": {
        "all": [
          {
            "path": "device.category",
            "op": "eq",
            "value": "wireless-iem-receiver"
          },
          {
            "path": "device.controls.limiter",
            "op": "ne",
            "value": true
          }
        ]
      },
      "explanation": "Un débranchement de micro alimenté ou une bouffée de bruit HF peut produire dans les ears des crêtes au-delà de 130 dB SPL. Shure demande de n'utiliser que des récepteurs avec limiteur et de ne jamais le désactiver ; un limiteur avant l'émetteur ne protège pas contre les artefacts après la liaison HF.",
      "fix": "Activer le limiteur du récepteur et baisser le volume s'il agit souvent.",
      "evaluable_now": false,
      "needs_catalog_fields": [
        "device.category:wireless-iem-receiver",
        "device.controls.limiter"
      ],
      "concept_ids": [
        "iem-receiver-limiter",
        "in-ear-monitoring",
        "noise-induced-hearing-loss"
      ],
