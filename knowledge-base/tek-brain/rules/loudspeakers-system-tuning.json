    {
      "id": "speakon-pin-mismatch-sub",
      "name_fr": "Subwoofer sur une paire speakON non alimentée",
      "name_en": "speakON pin mismatch on subwoofer",
      "domain": "loudspeakers-system-tuning",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "error",
      "scope": "connection",
      "condition": {
        "all": [
          {
            "path": "src.port.connector",
            "op": "eq",
            "value": "speakon-nl4"
          },
          {
            "path": "dst.port.connector",
            "op": "eq",
            "value": "speakon-nl4"
          },
          {
            "path": "dst.port.speakon_pairs_used",
            "op": "includes",
            "value": "2"
          },
          {
            "path": "src.port.speakon_pairs_driven",
            "op": "excludes",
            "value": "2"
          }
        ]
      },
      "explanation": "Un NL4 a deux paires (1± et 2±). Chez d&b, les tops V8 utilisent 1± et le V-SUB 2± ; la NEXO GEO M10 utilise 2± avec 1± en traversée. Si la sortie d'ampli (ou le câble) ne porte que 1±, l'enceinte câblée sur 2± ne reçoit rien : sub muet alors que tout semble branché.",
      "fix": "Alimenter le sub depuis une sortie qui délivre 2± (canal configuré en conséquence, câble NL4 4 conducteurs), ou utiliser l'adaptateur/le câblage prévu par le constructeur.",
      "evaluable_now": false,
      "needs_catalog_fields": [
