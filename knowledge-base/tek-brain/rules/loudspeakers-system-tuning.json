    {
      "id": "amp-load-impedance-too-low",
      "name_fr": "Charge trop basse sur un canal d'ampli",
      "name_en": "Amplifier load impedance too low",
      "domain": "loudspeakers-system-tuning",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "error",
      "scope": "graph",
      "condition": {
        "all": [
          {
            "path": "src.port.signal",
            "op": "eq",
            "value": "speaker-level"
          },
          {
            "path": "src.port.computed_load_ohms",
            "op": "lt",
            "value": {
              "ref": "src.device.min_load_ohms"
            }
          }
        ]
      },
      "explanation": "La charge vue par une sortie d'ampli est la combinaison en parallèle de toutes les enceintes raccordées (1/Z = Σ 1/Zi). Sous le minimum du fabricant, l'ampli chauffe, écrête, se met en protection ou fait déclencher son disjoncteur (QSC : pas de charge de 2 Ω en ponté, 4 Ω minimum). Les constructeurs d'enceintes limitent aussi le nombre de caissons par canal (d&b : 2 par canal).",
      "fix": "Retirer des enceintes du canal, les répartir sur d'autres canaux, ou utiliser un ampli spécifié pour cette charge ; respecter la table enceintes/canal du constructeur.",
      "evaluable_now": false,
      "needs_catalog_fields": [
        "port.nominal_impedance_ohms (enceintes)",
        "device.min_load_ohms (amplis, par mode stéréo/ponté)",
        "port.computed_load_ohms (calcul moteur : parallèle de toutes les enceintes chaînées sur la sortie)",
        "device.max_cabinets_per_channel"
      ],
      "concept_ids": [
        "speaker-impedance-load",
        "bridge-mode-amplifier"
      ],
      "sources": [
        {
          "url": "http://hyperphysics.phy-astr.gsu.edu/hbase/electric/imped.html",
