    {
      "id": "amplifier-power-mismatch",
      "name_fr": "Puissance d'ampli inadaptée à l'enceinte",
      "name_en": "Amplifier power mismatch",
      "domain": "loudspeakers-system-tuning",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "warning",
      "scope": "connection",
      "condition": {
        "all": [
          {
            "path": "dst.port.signal",
            "op": "eq",
            "value": "speaker-level"
          },
          {
            "path": "src.port.power_w_at_load_over_dst_rating",
            "op": "gt",
            "value": 2
          }
        ]
      },
      "explanation": "EAW recommande un ampli d'environ deux fois la tenue en puissance de l'enceinte quand toute sa capacité est nécessaire, sous réserve d'une exploitation maîtrisée. Au-delà, l'enceinte dépend entièrement des limiteurs. EAW rappelle aussi qu'un ampli trop petit n'est pas une protection : l'écrêtage peut détruire une enceinte même avec un ampli sous-dimensionné. Il n'existe pas de norme universelle de mesure de puissance, donc le rapport n'est qu'un indicateur.",
      "fix": "Choisir l'ampli et le preset recommandés par le constructeur (ex. NEXO : 750 W par GEO M10), activer les limiteurs, éviter l'écrêtage dans toute la chaîne.",
      "evaluable_now": false,
      "needs_catalog_fields": [
        "device.power_w_by_load (amplis : puissance à 8/4/2 Ω)",
        "port.power_handling_w_rms (enceintes)",
        "port.power_handling_w_peak (enceintes)",
        "src.port.power_w_at_load_over_dst_rating (calcul moteur)"
      ],
      "concept_ids": [
        "amplifier-power-rating",
        "speaker-impedance-load"
      ],
      "sources": [
