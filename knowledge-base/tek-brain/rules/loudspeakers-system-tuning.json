    {
      "id": "sub-top-polarity-misalignment",
      "name_fr": "Subs et tops en opposition au croisement",
      "name_en": "Sub/top polarity or delay misalignment",
      "domain": "loudspeakers-system-tuning",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "warning",
      "scope": "session",
      "condition": {
        "any": [
          {
            "path": "session.sub_top_phase_offset_at_crossover_deg",
            "op": "gt",
            "value": 90
          },
          {
            "path": "session.sub_top_relative_polarity_inverted",
            "op": "eq",
            "value": true
          }
        ]
      },
      "explanation": "Autour du croisement, subs et tops reproduisent les mêmes fréquences. Une polarité inversée ou un retard proche d'une demi-période (9,5 ms pour un croisement à 52 Hz) les fait s'annuler : grave creux au croisement. L'alignement n'est valable qu'au point de référence choisi.",
      "fix": "Mesurer en fonction de transfert au point de référence, corriger polarité puis retard jusqu'à superposer les phases au croisement.",
