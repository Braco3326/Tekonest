    {
      "id": "multiple-preferred-leaders",
      "name_fr": "Plusieurs Preferred Leader ou leader en conflit avec une sync externe",
      "name_en": "Multiple preferred leaders",
      "domain": "audio-networks",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "warning",
      "scope": "graph",
      "condition": {
        "any": [
          {
            "path": "graph.count(device.controls.dantePreferredLeader == true)",
            "op": "gt",
            "value": 1
          },
          {
            "all": [
              {
                "path": "graph.count(device.controls.danteSyncToExternal == true)",
                "op": "gte",
                "value": 1
              },
              {
                "path": "graph.count(device.controls.dantePreferredLeader == true AND device.controls.danteSyncToExternal == false)",
                "op": "gte",
                "value": 1
              }
            ]
          }
        ]
      },
      "explanation": "Avec plusieurs Preferred Leader, la MAC la plus basse l'emporte de façon peu lisible ; un appareil en « Sync To External » face à un Preferred Leader qui ne suit pas la même horloge perd la synchro et finit en sourdine.",
      "fix": "Un seul Preferred Leader par domaine d'horloge ; si une horloge externe est utilisée, c'est l'appareil qui la reçoit qui doit être leader.",
      "evaluable_now": false,
      "needs_catalog_fields": [
        "device.controls:dantePreferredLeader",
        "device.controls:danteSyncToExternal"
      ],
      "concept_ids": [
        "ptp-leader-election",
        "clock-master"
      ],
