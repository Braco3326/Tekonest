      "id": "dante-redundancy-crossed",
      "name_fr": "Redondance Dante croisée (primaire vers secondaire)",
      "name_en": "Crossed Dante redundancy",
      "domain": "audio-networks",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "error",
      "scope": "connection",
      "condition": {
        "any": [
