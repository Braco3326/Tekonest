    {
      "id": "eee-enabled-switch",
      "name_fr": "EEE actif sur un switch du réseau audio",
      "name_en": "EEE enabled on an audio network switch",
      "domain": "audio-networks",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "warning",
      "scope": "device",
      "condition": {
        "all": [
          {
            "path": "device.category",
            "op": "eq",
            "value": "network-switch"
          },
          {
            "path": "device.controls.eee",
            "op": "eq",
            "value": true
          },
          {
            "path": "device.ports[connected].signal",
            "op": "includes",
            "value": "aoip"
          }
        ]
      },
      "explanation": "L'Ethernet économe en énergie (IEEE 802.3az) déstabilise les horloges PTP : risque de perte de synchro, de coupures et de mise en sourdine des appareils Dante.",
      "fix": "Désactiver l'EEE sur tous les ports Dante ; ne pas utiliser de switch non administrable qui supporte l'EEE.",
      "evaluable_now": false,
      "needs_catalog_fields": [
        "device.controls:eee",
        "device.category:network-switch"
      ],
      "concept_ids": [
