                "value": "isDantePrimary"
              },
              {
                "path": "dst.port.flags",
                "op": "includes",
                "value": "isDanteSecondary"
              }
            ]
          },
          {
            "all": [
              {
                "path": "src.port.flags",
                "op": "includes",
                "value": "isDanteSecondary"
              },
              {
                "path": "dst.port.flags",
                "op": "includes",
                "value": "isDantePrimary"
              }
            ]
          }
        ]
      },
      "explanation": "Les interfaces secondaires ne peuvent pas communiquer avec les interfaces primaires : un câble direct primaire-secondaire ne transporte aucun audio et peut ponter les deux réseaux.",
      "fix": "Relier primaire à primaire et secondaire à secondaire (ou chaque port à son switch dédié).",
      "evaluable_now": false,
