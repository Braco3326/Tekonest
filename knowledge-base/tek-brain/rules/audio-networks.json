    {
      "id": "dante-latency-too-low-100mbps",
      "name_fr": "Latence Dante inférieure à 1 ms sur un lien 100 Mbit/s",
      "name_en": "Dante latency below 1 ms on a 100 Mbps link",
      "domain": "audio-networks",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "error",
      "scope": "connection",
      "condition": {
        "all": [
          {
            "path": "src.port.signal",
            "op": "eq",
            "value": "aoip"
          },
          {
            "path": "dst.port.linkSpeedMbps",
            "op": "lte",
            "value": 100
          },
          {
            "path": "dst.device.controls.danteLatencyMs",
            "op": "lt",
            "value": 1
          }
        ]
      },
      "explanation": "Audinate : la latence minimale d'un appareil relié à un port 100 Mbit/s est 1 ms ; en dessous, l'abonnement échoue (« Tx Scheduler Failure »).",
      "fix": "Monter la latence à 1 ms ou plus, ou relier l'appareil en Gigabit.",
      "evaluable_now": false,
      "needs_catalog_fields": [
        "port.linkSpeedMbps",
        "device.controls:danteLatencyMs"
      ],
      "concept_ids": [
