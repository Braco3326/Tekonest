      "id": "primary-secondary-same-switch",
      "name_fr": "Primaire et secondaire sur le même switch",
      "name_en": "Primary and secondary on the same switch",
      "domain": "audio-networks",
      "catalog_rule": null,
      "status": "proposed",
      "severity": "error",
      "scope": "graph",
      "condition": {
        "all": [
          {
            "path": "graph.count(device.category == 'network-switch' AND device.ports[connected].flags includes 'isDantePrimary' AND device.ports[connected].flags includes 'isDanteSecondary')",
            "op": "gt",
            "value": 0
          }
        ]
      },
      "explanation": "Un même switch relie à la fois des ports Dante primaires et secondaires : les deux réseaux sont joints, la redondance disparaît et des conflits d'adressage apparaissent (Audinate).",
