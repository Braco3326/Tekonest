{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-base/schema/device.schema.json",
  "title": "Equipment file (knowledge-base/equipment/<file>.json)",
  "type": "object",
  "required": ["file", "category", "generated", "devices"],
  "properties": {
    "file": { "type": "string", "description": "This file's name, e.g. microphones-condenser.json" },
    "category": { "type": "string", "description": "taxonomy.json category id" },
    "generated": { "type": "string", "description": "YYYY-MM-DD" },
    "selection_rationale": { "type": "string" },
    "not_found_log": {
      "type": "array",
      "description": "Devices/specs/manuals searched for but not found",
      "items": { "type": "object", "properties": { "device_id": {"type":"string"}, "what": {"type":"string"}, "searched": {"type":"string"} } }
    },
    "devices": { "type": "array", "items": { "$ref": "#/$defs/device" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["url", "publisher", "accessed", "confidence", "covers"],
      "properties": {
        "url": { "type": "string" },
        "publisher": { "type": "string" },
        "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "confidence": { "enum": ["verified-primary", "verified-secondary", "unverified"] },
        "kind": { "enum": ["manufacturer", "standard", "education-official", "trade-press", "retailer", "textbook", "forum", "other"] },
        "covers": { "type": "array", "items": { "type": "string" }, "description": "Field names or key_specs.<key> this source supports" },
        "url_status": { "type": "string", "description": "Filled by tools/check_urls.py" }
      }
    },
    "manual": {
      "type": "object",
      "required": ["url", "language", "official"],
      "properties": {
        "url": { "type": "string" },
        "title": { "type": "string" },
        "language": { "type": "string", "description": "ISO 639-1 code(s), e.g. 'fr', 'en', 'multi'" },
        "file_type": { "type": "string" },
        "version_or_date": { "type": "string" },
        "official": { "type": "boolean" },
        "kind": { "enum": ["user-manual", "datasheet", "spec-sheet", "quick-start", "service", "other"] },
        "url_status": { "type": "string" }
      }
    },
    "device": {
      "type": "object",
      "required": ["id", "brand", "model", "category", "sub_type", "technology", "year_introduced", "status", "why_it_is_a_classic", "typical_uses", "key_specs", "connectors", "signal_types", "manual_url", "datasheet_url", "product_page_url", "manual_languages", "manuals", "sources", "notes", "conflicts", "tekpractice"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "category": { "type": "string" },
        "sub_type": { "type": "string" },
        "technology": { "type": "string" },
        "year_introduced": { "type": ["integer", "string"], "description": "integer year or 'not found'" },
        "status": { "enum": ["current", "discontinued", "not found"] },
        "why_it_is_a_classic": { "type": "string" },
        "typical_uses": { "type": "array", "items": { "type": "string" } },
        "key_specs": { "type": "object", "description": "Free keys; values are strings/numbers/arrays exactly as the source states them, units included" },
        "connectors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["connector", "role"],
            "properties": {
              "connector": { "type": "string", "description": "TekPractice connector id or proposed id from taxonomy.json" },
              "role": { "type": "string", "description": "e.g. 'mic out', 'Dante primary', 'mains in'" },
              "dir": { "enum": ["in", "out", "bidir", "n/a"] },
              "signal": { "type": "string" },
              "count": { "type": ["integer", "string"] }
            }
          }
        },
        "signal_types": { "type": "array", "items": { "type": "string" } },
        "manual_url": { "type": "string" },
        "datasheet_url": { "type": "string" },
        "product_page_url": { "type": "string" },
        "manual_languages": { "type": "array", "items": { "type": "string" } },
        "manuals": { "type": "array", "items": { "$ref": "#/$defs/manual" } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "notes": { "type": "string" },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "values"],
            "properties": {
              "field": { "type": "string" },
              "values": { "type": "array", "items": { "type": "object", "properties": { "value": {}, "source_url": { "type": "string" } } } },
              "note": { "type": "string" }
            }
          }
        },
        "tekpractice": {
          "type": "object",
          "properties": {
            "in_catalog": { "type": "boolean" },
            "catalog_id": { "type": ["string", "null"] },
            "proposed_new_connectors": { "type": "array", "items": { "type": "string" } },
            "proposed_new_signals": { "type": "array", "items": { "type": "string" } },
            "sim_value": { "enum": ["high", "medium", "low"], "description": "How useful adding this device to TekPractice would be" },
            "sim_value_reason": { "type": "string" }
          }
        }
      }
    }
  }
}
